{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.anthropic.com/**" },
        { "url": "https://api.openai.com/**" }
      ]
    }
  ]
}
